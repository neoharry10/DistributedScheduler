{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Worker": {
    "Queues": {
      "critical": { "Concurrency": 2, "BatchSize": 2 },
      "default":  { "Concurrency": 8, "BatchSize": 8 },
      "bulk":     { "Concurrency": 4, "BatchSize": 4 }
    },
    "RateLimits": { "SendEmailJob": 5 }
  }
}
